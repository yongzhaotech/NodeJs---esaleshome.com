{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": [
    "service.ts",
    "js/**/*.js",
    "module/**/*.js",
    "module/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "js/static-vars.js"
  ]
}
